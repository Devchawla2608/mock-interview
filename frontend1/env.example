# EmailJS Configuration
# Replace these values with your actual EmailJS credentials
# Get these from your EmailJS dashboard: https://www.emailjs.com/

# Your EmailJS Service ID (from Email Services section)
REACT_APP_EMAILJS_SERVICE_ID=your_service_id_here

# Your EmailJS Template ID for OTP emails (from Email Templates section)
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id_here

# Your EmailJS Public Key (from Account section)
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your EmailJS Template ID for welcome emails (optional)
REACT_APP_EMAILJS_WELCOME_TEMPLATE_ID=your_welcome_template_id_here

# Application Configuration
REACT_APP_NAME=Mock Interview Platform
REACT_APP_SUPPORT_EMAIL=support@mockinterview.com
REACT_APP_WEBSITE_URL=https://mockinterview.com

# Backend API URL
REACT_APP_API_URL=http://localhost:3001 